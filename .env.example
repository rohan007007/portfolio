# ==============================================================================
# Rohan Lodaya — Automotive Systems & Connected Vehicle Portfolio
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the respective directories or root as needed:
#   frontend/.env
#   backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Craco)
# ------------------------------------------------------------------------------
PORT=3000
REACT_APP_BACKEND_URL=http://localhost:8000
PUBLIC_URL=

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db
SECRET_KEY=your_secure_random_secret_key_here
CORS_ORIGINS=http://localhost:3000,https://rohan007007.github.io

# ------------------------------------------------------------------------------
# Antigravity Skills & AI Integrations
# ------------------------------------------------------------------------------
# Required for video-ui-feedback skill and Gemini multimodal analysis
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# MCP Server Credentials (Optional / External Tools)
# ------------------------------------------------------------------------------
# Kite MCP Server (Zerodha trading & portfolio data)
KITE_API_KEY=your_kite_api_key_here
KITE_ACCESS_TOKEN=your_kite_access_token_here
