{
  "mcpServers": {
    "kite": {
      "command": "python",
      "args": [
        "-u",
        "path/to/run_kite_mcp.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "KITE_API_KEY": "YOUR_KITE_API_KEY",
        "KITE_ACCESS_TOKEN": "YOUR_KITE_ACCESS_TOKEN"
      },
      "description": "Zerodha Kite Connect MCP server for market data and portfolio execution."
    },
    "screener": {
      "command": "python",
      "args": [
        "-u",
        "path/to/run_screener_mcp.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Screener.in financial analysis, peer comparisons, and fundamentals MCP server."
    },
    "gemini-api-docs": {
      "command": "npx",
      "args": [
        "-y",
        "@google/gemini-api-docs-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY"
      },
      "description": "Upstream Google Gemini API and SDK documentation server."
    }
  }
}
